{
  "name": "tadcap",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:screenshots:before": "UI_SCREENSHOT_LABEL=before playwright test --config=e2e/screenshots/playwright.config.ts",
    "e2e:screenshots:after": "UI_SCREENSHOT_LABEL=after playwright test --config=e2e/screenshots/playwright.config.ts",
    "dist:mac": "bash scripts/package-mac.sh",
    "latency:summary": "node scripts/latency-summary.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
